# Locally reproducible Ghidra decompiler output; do not treat OEM C-like output
# as an independent implementation artifact.
analysis/**/*_decompile.c
analysis/functions/FUN_*
analysis/protocol/FUN_*
analysis/protocol/control_descriptor_refs.csv
analysis/flow/FUN_*
analysis/clocks/FUN_*
analysis/timers/FUN_*
analysis/usart/FUN_*
analysis/dma/FUN_*
analysis/i2s/FUN_*
analysis/dsp_primitives/FUN_*
analysis/rtos/FUN_*
analysis/analog/FUN_*
analysis/gpio/FUN_*
analysis/i2c/FUN_*
analysis/watchdog/FUN_*
analysis/memory/FUN_*
analysis/frequency_control/FUN_*
analysis/rf_switching/FUN_*
analysis/tx_filters/FUN_*

# Preserve decompiler/disassembly evidence for independent implementation
# verification. These files remain reference evidence, not source code for
# the replacement firmware.
!analysis/**/*_decompile.c
!analysis/**/*_decompile.txt
!analysis/**/*_decompilation.txt
!analysis/**/*_disassembly.txt
